CONFIG_IDF_TARGET="esp32s3"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_OTA_SUITE_UPDATE_MANIFEST_URL="https://updates.example.org/BatteryTester/firmware.json"
CONFIG_OTA_SUITE_STATUS_LED_ENABLE=y
CONFIG_OTA_SUITE_LED_GPIO=48
CONFIG_OTA_SUITE_AP_SSID_PREFIX="BatteryTester"
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_OTA_SUITE_WEB_TAB_ORDER="dashboard,battery,manual,auto,resistance,overview,test-runs,sd-card,updates,settings,debug"
CONFIG_OTA_SUITE_WEB_PRIMARY_TABS="dashboard,battery,manual,auto,resistance"
CONFIG_OTA_SUITE_WEB_ACTIVITY_URL="/api/tester/status"
CONFIG_OTA_SUITE_WEB_SD_LANGUAGES=y
CONFIG_OTA_SUITE_WEB_SETTINGS_REQUIRE_PASSWORD=y
