# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.0.1 Project Minimal Configuration
#
# default:
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_EBC_TESTER_UART_TX_GPIO=10
CONFIG_EBC_TESTER_UART_RX_GPIO=11
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
CONFIG_OTA_SUITE_AP_SSID_PREFIX="ebct"
CONFIG_OTA_SUITE_AP_PASSWORD="ebctester"
CONFIG_OTA_SUITE_STATUS_LED_ENABLE=y
CONFIG_OTA_SUITE_UPDATE_MANIFEST_URL="https://ebctester.gemelon.de/firmware.json"
CONFIG_OTA_SUITE_WEB_SD_LANGUAGES=y
CONFIG_OTA_SUITE_WEB_PRIMARY_TABS="dashboard,battery,manual,auto,resistance"
CONFIG_OTA_SUITE_WEB_ACTIVITY_URL="/api/tester/status"
CONFIG_OTA_SUITE_WEB_TAB_ORDER="dashboard,battery,manual,auto,resistance,overview,test-runs,sd-card,updates,settings,debug"
CONFIG_SD_CARD_MANAGER_GPIO_CARD_DETECT=13
CONFIG_SD_CARD_MANAGER_GPIO_CLK=6
CONFIG_SD_CARD_MANAGER_GPIO_CMD=7
CONFIG_SD_CARD_MANAGER_GPIO_D0=5
CONFIG_SD_CARD_MANAGER_GPIO_D2=18
CONFIG_SD_CARD_MANAGER_GPIO_D3=17
CONFIG_SD_CARD_MANAGER_GPIO_SPI_MISO=5
CONFIG_SD_CARD_MANAGER_GPIO_SPI_MOSI=7
CONFIG_SD_CARD_MANAGER_GPIO_SPI_CS=17
CONFIG_SD_CARD_MANAGER_GPIO_SPI_CLK=6
